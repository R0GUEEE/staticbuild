        },
        "ios-arm64": {
          "tier": "macho",
          "status": "not-supported",
          "entry": "",
          "notes": "There is no aarch64-apple-ios *host* port of swiftc; Swift is a cross compiler only. iOS ships libswift*.dylib in /usr/lib/swift but that is a runtime, not a compiler. Use the macos-arm64 bundle."

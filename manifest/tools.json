{
  "schema": 1,
  "updated": "2026-10-30",
  "targets": {
    "linux-arm64": {
      "family": "elf",
      "abi": "musl",
      "meaning": "fully static ELF; runs on any aarch64 Linux kernel, including the iOS sandbox guest",
      "runs_on": "ubuntu-24.04-arm"
    },
    "linux-x86_64": {
      "family": "elf",
      "abi": "musl",
      "meaning": "fully static ELF for CI hosts and desktop Linux",
      "runs_on": "ubuntu-24.04"
    },
    "ios-arm64": {
      "family": "macho",
      "abi": "iphoneos",
      "meaning": "Mach-O for the iOS sandbox: links nothing but the dyld-shared cache libraries (libSystem, libc++, Foundation, libobjc)",
      "runs_on": "macos-14"
    },
    "macos-arm64": {
      "family": "macho",
      "abi": "macos",
      "meaning": "Mach-O host tool, used to cross-compile iOS products on a Mac",
      "runs_on": "macos-14"
    }
  },
  "tiers": {
    "static": "one ELF, zero DT_NEEDED, ldd says 'not a dynamic executable'",
    "sfx": "static stub + zstd payload carrying a tree (compiler resource dir, stdlib, JRE)",
    "layer": "sfx whose payload splits shared runtime trees into hash-addressed layers reused across bundles",
    "macho": "one Mach-O (+ optional sfx payload of headers/SDK) that imports only OS-shipped dylibs"
  },
  "tools": [
    {
      "id": "llvm",
      "name": "Clang / LLVM",
      "version": "20.1.8",
      "license": "Apache-2.0 WITH LLVM-exception",
      "method": "source",
      "upstream": "https://github.com/llvm/llvm-project/releases/tag/llvmorg-20.1.8",
      "provides": [
        "clang",
        "clang++",
        "clang-cpp",
        "ld.lld",
        "lld",
        "llvm-ar",
        "llvm-ranlib",
        "llvm-nm",
        "llvm-strip",
        "llvm-objcopy",
        "llvm-objdump",
        "llvm-readelf",
        "llvm-size",
        "llvm-profdata",
        "llvm-install-name-tool",
        "llvm-otool",
        "llvm-lipo",
        "clang-format"
      ],
      "targets": {
        "linux-arm64": {
          "tier": "layer",
          "status": "ga",
          "entry": "bin/clang",
          "paths": [
            "bin"
          ],
          "size_budget_mb": 450,
          "smoke": "clang --version && printf 'int main(void){return 0;}\\n' > /tmp/t.c && clang -static -o /tmp/t /tmp/t.c && /tmp/t && ld.lld --version",
          "notes": "clang, clang++ and lld link the static libLLVM/libclang archives (CLANG_LINK_CLANG_DYLIB=OFF, LLVM_BUILD_LLVM_DYLIB=OFF), so every shipped tool is a zero-DT_NEEDED ELF. clang-tools-extra (clangd, clang-tidy) is a separate build: SB_LLVM_EXTRA=1. The lib/clang resource dir ships as a layer, so a project that carries clang also carries its builtin headers once.",
          "timeout": 360
        },
        "ios-arm64": {
          "tier": "macho",
          "status": "experimental",
          "entry": "bin/clang",
          "paths": [
            "bin"
          ],
          "size_budget_mb": 260,
          "smoke": "clang --version",
          "notes": "Built against the iPhoneOS SDK with LIBCXX_ENABLE_STATIC=ON and CLANG_LINK_CLANG_DYLIB=OFF. Headers and .tbd stubs for compiling *for* iOS are Apple-licensed and are NOT shipped; the bundle compiles for the running device using the SDK tree supplied by the host app, exactly the a-Shell model."
        },
        "macos-arm64": {
          "tier": "sfx",
          "status": "ga",
          "entry": "bin/clang",
          "paths": [
            "bin"
          ],
          "size_budget_mb": 240,
          "smoke": "clang --version"
        }
      }
    },
